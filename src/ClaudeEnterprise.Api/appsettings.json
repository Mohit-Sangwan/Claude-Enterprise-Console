{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "System.Net.Http.HttpClient": "Warning"
      }
    }
  },
  "AllowedHosts": "*",
  "Cors": {
    "AllowedOrigins": [
      "http://localhost:5099",
      "http://localhost:5173",
      "https://localhost:5173"
    ]
  },
  "Security": {
    "HeaderName": "X-API-Key",
    "ApiKeys": []
  },
  "Persistence": {
    "Provider": "Sqlite",
    "ConnectionString": "Data Source=claude-enterprise.db"
  },
  "OpenTelemetry": {
    "ServiceName": "ClaudeEnterprise.Api",
    "OtlpEndpoint": ""
  },
  "Anthropic": {
    "ApiKey": "",
    "Model": "claude-sonnet-4-5",
    "MaxTokens": 1024,
    "Temperature": 0.7,
    "MaxRetries": 2,
    "TimeoutSeconds": 120,
    "DefaultSystemPrompt": "You are a helpful enterprise AI assistant. Be concise, accurate, and cite assumptions."
  }
}
